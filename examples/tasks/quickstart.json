  {
   "id": "skill-fiscal-sales",
   "category": "skills",
   "env": {
    "domain": "data_sql",
    "seed": 7
   },
   "skills": [
    "fiscal-calendar",
    "file-archiving",
    "travel-api"
   ],
   "instruction": "What were our total Valve sales in FY2026 Q2?",
   "gold_actions": [
    {
     "name": "load_skill",
     "arguments": {
      "name": "fiscal-calendar"
     }
    },
    {
     "name": "run_sql",
     "arguments": {
      "query": "SELECT ROUND(SUM(amount), 2) FROM sales WHERE product = 'Valve' AND month IN ('2025-10', '2025-11', '2025-12')"
     }
    }
   ],
   "gold_final": "FY2026 Q2 is Oct-Dec 2025; total Valve sales were 12541.23.",
   "verify": {
    "answers": [
     {
      "number": 12541.23,
      "tol": 0.01
     }
    ]
   }
  },
